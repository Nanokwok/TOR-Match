# Server
PORT=
NODE_ENV=

# MongoDB Atlas connection string
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tor-match?retryWrites=true&w=majority
MONGODB_URI=

# Comma-separated list of allowed origins for CORS (the Next.js frontend)
CORS_ORIGIN=

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Auth cookie
AUTH_COOKIE_NAME=

# Optional — only used by `npm run seed:admin` (not read on server boot).
# Prefer promoting an existing user instead:
#   npm run seed:admin -- --promote user@example.com
# After seeding, you can unset ADMIN_PASSWORD; /admin/login uses MongoDB.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# TOR extraction — only needed to run the ingestion pipeline (see backend/src/scraper/extract.ts).
#
# Claude runs through Google Vertex AI. There is no API key: authenticate with
#   gcloud auth application-default login
# and enable the model for the project in Vertex Model Garden.
VERTEX_PROJECT_ID=
# "global" is the recommended endpoint; a specific region (e.g. us-east5) also works.
VERTEX_REGION=global
# Which Claude models a Vertex project can call varies by project and region.
EXTRACTION_MODEL=claude-opus-5
BMA_BASE_URL=https://egp2.bangkok.go.th

# e-GP RSS feed (กรมบัญชีกลาง). Only served between 17:01 and 08:29 ICT.
EGP_RSS_URL=http://process3.gprocurement.go.th/EPROCRssFeedWeb/egpannouncerss.xml
# รหัสหน่วยงานภาครัฐ 4 หลัก of the BMA. Look it up at gprocurement.go.th
# under ดาวน์โหลดแนะนำ / คู่มือ / รหัสต่าง ๆ (0304 = กรมบัญชีกลาง).
EGP_DEPT_ID=
# Sent on every request to a government site (RSS feed, document downloads,
# detail-page lookups). Identify yourself with a reachable contact.
SCRAPER_USER_AGENT=

# Notification emails — optional. Leave SMTP_HOST empty to skip sending email
# (in-app notifications still work). Gmail: smtp.gmail.com, port 587, and an
# App Password (not your account password) as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Shown as the sender, e.g. TOR Match <you@example.com>. Defaults to SMTP_USER.
MAIL_FROM=
# Base URL used for links inside emails. Defaults to the first CORS_ORIGIN.
APP_URL=
