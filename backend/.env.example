# Server
PORT=
NODE_ENV=

# MongoDB Atlas connection string
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tor-match?retryWrites=true&w=majority
MONGODB_URI=

# Comma-separated list of allowed origins for CORS (the Next.js frontend)
CORS_ORIGIN=

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Auth cookie
AUTH_COOKIE_NAME=
