# Server
PORT=
NODE_ENV=

# MongoDB Atlas connection string
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tor-match?retryWrites=true&w=majority
MONGODB_URI=

# Comma-separated list of allowed origins for CORS (the Next.js frontend)
CORS_ORIGIN=

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Auth cookie
AUTH_COOKIE_NAME=

# Admin account created by `npm run seed:admin` (the /admin screens sign in with it)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# TOR scraper (`npm run scrape`) — only needed to run the ingestion pipeline.
# Requires a one-time `npx playwright install chromium`.
ANTHROPIC_API_KEY=
BMA_BASE_URL=https://egp2.bangkok.go.th
# Sent on every scraper request. egp2.bangkok.go.th allows crawling its public
# pages; identifying yourself with a reachable contact is the other half of that.
SCRAPER_USER_AGENT=
