# Base URL of the backend API (backend/src/routes mounts everything under /api).
# Must match the port the backend actually runs on — see backend/.env (PORT).
#
# NOTE: NEXT_PUBLIC_* values are inlined into the client bundle and are readable
# by anyone. Never put secrets or API keys behind this prefix.
NEXT_PUBLIC_API_URL=

# Name of the auth cookie set by Server Actions after login/register.
# Must match AUTH_COOKIE_NAME in backend/.env (backend defaults to tm_token
# when unset, but frontend requires it explicitly — see src/lib/env.ts).
AUTH_COOKIE_NAME=